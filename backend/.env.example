# ─────────────────────────────────────────────────────────────────────────────
# DevCircle Backend — Environment Variables
# Copy this file to .env and fill in all required values.
# Required variables will cause the server to refuse to start if missing.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
# Environment: "development" | "production" | "test"
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# REQUIRED — MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT Authentication ────────────────────────────────────────────────────────
# REQUIRED — Use a strong, random string of 32+ characters
JWT_ACCESS_SECRET=replace_with_a_random_string_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_string_of_at_least_32_characters

# Token expiry durations (ms string format supported by jsonwebtoken)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS & Frontend URLs ─────────────────────────────────────────────────────
# URL of the deployed frontend (used in CORS allowlist and email links)
FRONTEND_URL=http://localhost:3000

# Public site URL (used in verification/notification emails)
SITE_URL=http://localhost:3000

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# From https://console.cloud.google.com/apis/credentials
# Optional — Google login will be disabled if not set
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ─── Cloudinary — File Storage ────────────────────────────────────────────────
# REQUIRED — Used for resume PDFs, profile pictures, and company media
# From https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── OpenRouter — AI / LLM ────────────────────────────────────────────────────
# Optional — AI features (ATS scoring, resume analysis, etc.) will be disabled if not set
# From https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key

# ─── Redis — Job Queue (BullMQ) ───────────────────────────────────────────────
# Optional — Email queue falls back to in-memory async dispatch if Redis is unavailable
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional — only set if your Redis instance requires authentication
REDIS_PASSWORD=

# ─── SMTP — Email Delivery ────────────────────────────────────────────────────
# Optional — all emails will be printed to console (mock mode) if not set
# Example values for Gmail (use App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=DevCircle <noreply@devcircle.com>

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Window duration in milliseconds (default: 15 minutes = 900000 ms)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per IP per window for general API endpoints
RATE_LIMIT_MAX=100
